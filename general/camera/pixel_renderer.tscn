[gd_scene load_steps=5 format=3 uid="uid://bpx5r3ndm7q4e"]

[ext_resource type="Script" path="res://general/scripts/pixel_renderer.gd" id="1_renderer"]

[sub_resource type="Shader" id="Shader_fx"]
code = "shader_type canvas_item;

uniform float grain_amount     : hint_range(0.0, 0.2) = 0.06;
uniform float grain_speed      : hint_range(0.0, 10.0) = 2.0;
uniform float vignette_strength : hint_range(0.0, 6.0) = 1.5;
uniform float grain_coverage   : hint_range(0.0, 1.0) = 0.6;

float rand(vec2 uv) {
	return fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
}

// 双线性插值值噪声：四角随机值 + smoothstep 曲线，完全无硬切边
float value_noise(vec2 uv) {
	vec2 i = floor(uv);
	vec2 f = fract(uv);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = rand(i);
	float b = rand(i + vec2(1.0, 0.0));
	float c = rand(i + vec2(0.0, 1.0));
	float d = rand(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

void fragment() {
	vec4 col = texture(TEXTURE, UV);

	// 有机低频遮罩：value_noise 缓慢漂移，无硬切边
	vec2 mask_uv = UV * vec2(6.0, 4.0) + TIME * grain_speed * 0.06;
	float presence = value_noise(mask_uv);
	float weight = smoothstep(1.0 - grain_coverage - 0.15, 1.0 - grain_coverage + 0.15, presence);

	// 高频胶片颗粒（480x270 像素对齐，X/Y 不同速打破对称）
	vec2 g_uv = floor(UV * vec2(480.0, 270.0) + TIME * grain_speed * vec2(17.0, 13.0));
	float grain = (rand(g_uv) * 2.0 - 1.0) * grain_amount * weight;
	col.rgb += grain;

	// 暗角：二次方衰减，中心不变，边角渐暗
	vec2 c = UV - vec2(0.5);
	float vignette = 1.0 - dot(c, c) * vignette_strength;
	col.rgb *= clamp(vignette, 0.0, 1.0);

	COLOR = col;
}
"


[ext_resource type="Script" uid="uid://d0c3vj8pllouh" path="res://general/scripts/pixel_renderer.gd" id="1_renderer"]

[sub_resource type="Shader" id="Shader_fx"]
code = "shader_type canvas_item;

uniform float brightness : hint_range(0.5, 2.0) = 1.0;
uniform float contrast : hint_range(0.5, 2.0) = 1.0;
uniform float vignette_strength : hint_range(0.0, 1.0) = 0.6;
uniform vec4 vignette_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);

// 蔚蓝式 sharp-bilinear（抗锯齿最近邻）上采样：
// 纹素内部平涂保持绝对锐利，仅在纹素接缝处用 1 物理像素宽的线性过渡。
// 非整数缩放（如 2.84×）下消除像素大小不均导致的 shimmer，
// 同时让亚像素相机平移完全平滑。要求 texture_filter = Linear。
vec2 sharp_uv(vec2 uv, vec2 tex_size) {
	vec2 px = uv * tex_size;          // 转到纹素坐标
	vec2 seam = floor(px + 0.5);      // 最近的纹素接缝
	vec2 dudv = fwidth(px);           // 单个屏幕像素跨越多少纹素
	px = seam + clamp((px - seam) / dudv, -0.5, 0.5);
	return px / tex_size;
}

void fragment() {
	vec2 tex_size = vec2(textureSize(TEXTURE, 0));
	vec4 col = texture(TEXTURE, sharp_uv(UV, tex_size));
	col.rgb *= brightness;
	col.rgb = (col.rgb - 0.5) * contrast + 0.5;

	// 只用 y 因子：上下边缘+四角压暗，左右边缘中心（y=0.5，vy=1）mask=0 完全无过渡
	float vy = UV.y * (1.0 - UV.y) * 4.0;
	float mask = (1.0 - clamp(pow(vy, 0.35), 0.0, 1.0)) * vignette_strength;
	col.rgb = mix(col.rgb, vignette_color.rgb, mask);

	col.rgb = clamp(col.rgb, 0.0, 1.0);
	COLOR = col;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fx"]
shader = SubResource("Shader_fx")
shader_parameter/brightness = 1.2
shader_parameter/contrast = 1.05
shader_parameter/vignette_strength = 0.6
shader_parameter/vignette_color = Color(0, 0, 0, 1)

